{
  "name": "vvirtual-grid",
  "version": "1.1.6",
  "keywords": [
    "grid",
    "virtual scroll",
    "vue",
    "windowing"
  ],
  "bugs": {
    "url": "https://github.com/astraldev/vvirtual-grid/issues"
  },
  "license": "MIT",
  "author": "Roc Wong <roc@kiwiberry.nz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astraldev/vvirtual-grid.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./vue": {
      "types": "./dist/integrations/vue/index.d.ts",
      "import": "./dist/integrations/vue/index.js"
    },
    "./nuxt": {
      "types": "./dist/integrations/nuxt/module.d.ts",
      "import": "./dist/integrations/nuxt/module.js"
    }
  },
  "scripts": {
    "prepare": "tsdown",
    "build": "tsdown",
    "release": "pnpm run build && changelogen --patch --release && npm publish --access public && git push --follow-tags",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "bench:report": "vitest bench",
    "profile": "./scripts/profile.sh"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "ramda": "^0.32.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@nuxt/kit": "^3.17.0",
    "@nuxt/schema": "^4.3.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/ramda": "^0.31.1",
    "@vitest/coverage-v8": "4.0.18",
    "consola": "^3.4.2",
    "happy-dom": "^17.1.0",
    "publint": "^0.3.17",
    "tinybench": "^6.0.0",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.1.1",
    "vitest": "^4.0.18",
    "vitest-github-actions-reporter": "^0.11.1",
    "vue": "^3.5.0",
    "vue-tsc": "^3.2.4"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
