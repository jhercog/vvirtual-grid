{
  "name": "vvirtual-grid",
  "version": "1.1.6",
  "type": "module",
  "exports": {
    ".": {
      "types": "./core/dist/src/index.d.ts",
      "import": "./core/dist/src/index.js"
    },
    "./vue": {
      "types": "./core/dist/integrations/vue/index.d.ts",
      "import": "./core/dist/integrations/vue/index.js"
    },
    "./nuxt": {
      "types": "./core/dist/integrations/nuxt/module.d.ts",
      "import": "./core/dist/integrations/nuxt/module.js"
    }
  },
  "files": [
    "core/dist"
  ],
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "ramda": "^0.32.0",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "scripts": {
    "format": "oxfmt",
    "prepare": "husky",
    "lint": "pnpm --filter=vvirtual-grid run lint",
    "test": "pnpm --filter=vvirtual-grid run test",
    "release": "pnpm --filter=vvirtual-grid run release"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@platformatic/flame": "^1.6.0",
    "changelogen": "^0.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "oxlint-tsgolint": "^0.14.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.0"
}
